# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
PUBLIC_BASE_URL=http://localhost:4173
# PUBLIC_BASE_URL=https://play.lafamila.xyz

# MariaDB - reuse the same server/connection account as todo-api-fastapi.
# Only DB_NAME is separate for this service.
DB_HOST=localhost
DB_PORT=33306
DB_USER=root
DB_PASSWORD=
DB_NAME=gbc_porting

# Container/NAS equivalents:
# DB_HOST=teddy-mysql
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=<same deployment secret used by todo-api-fastapi>
# DB_NAME=gbc_porting

# auth-api-nest OIDC
AUTH_ISSUER_URL=http://localhost:3032
AUTH_PUBLIC_BASE_URL=http://localhost:3032
AUTH_API_BASE_URL=http://localhost:3032
AUTH_JWKS_URL=http://localhost:3032/oauth/jwks
# AUTH_ISSUER_URL=https://auth.lafamila.xyz
# AUTH_PUBLIC_BASE_URL=https://auth.lafamila.xyz
# AUTH_API_BASE_URL=http://auth-api-nest:3032
# AUTH_JWKS_URL=http://auth-api-nest:3032/oauth/jwks
AUTH_AUDIENCE=service:gbc-porting
AUTH_SERVICE_KEY=gbc-porting

# Confidential client issued when auth approves auth/service-onboarding.json.
GBC_PORTING_OIDC_CLIENT_ID=gbc-porting-web
GBC_PORTING_OIDC_CLIENT_SECRET=
GBC_PORTING_OIDC_REDIRECT_URI=http://localhost:4173/auth/callback
# GBC_PORTING_OIDC_REDIRECT_URI=https://play.lafamila.xyz/auth/callback
GBC_PORTING_OIDC_TRANSACTION_TTL_SECONDS=300

# App-owned HttpOnly session. Generate with: openssl rand -base64 32
GBC_PORTING_SESSION_ENCRYPTION_KEY=
GBC_PORTING_SESSION_COOKIE_NAME=gbc_porting_session
GBC_PORTING_PLAYER2_SESSION_COOKIE_NAME=gbc_porting_player2_session
GBC_PORTING_OIDC_STATE_COOKIE_NAME=gbc_porting_oidc_state
GBC_PORTING_PLAYER2_OIDC_STATE_COOKIE_NAME=gbc_porting_player2_oidc_state
GBC_PORTING_SESSION_MAX_AGE_SECONDS=604800
GBC_PORTING_SECURE_COOKIES=false
# GBC_PORTING_SECURE_COOKIES=true

# Link cable message tracing. Enabled by default outside production.
LINK_DEBUG=true

# Internal local 2P lease. Expiry aborts the session and releases both save locks.
LOCAL_2P_SESSION_LEASE_SECONDS=90

# Persistent shared ROM storage. Account saves are stored in MariaDB.
ROM_STORAGE_DIR=./roms
FIXTURE_DIR=./data

# Production auth example:
# PUBLIC_BASE_URL and GBC_PORTING_OIDC_REDIRECT_URI must use the final service domain.
